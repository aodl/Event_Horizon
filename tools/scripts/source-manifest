#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
manifest="MANIFEST.sha256"
tracked_files() {
  git ls-files -z --cached | python3 -c 'import sys
for path in sys.stdin.buffer.read().split(b"\0"):
    if path and path != b"MANIFEST.sha256" and not path.startswith(b"release-artifacts/"):
        sys.stdout.buffer.write(path + b"\0")'
}
case "${1:-}" in
  generate)
    tracked_files | sort -z | xargs -0 sha256sum > "$manifest"
    ;;
  verify)
    expected="$(mktemp)"
    actual="$(mktemp)"
    duplicates="$(mktemp)"
    trap 'rm -f "$expected" "$actual" "$duplicates"' EXIT

    tracked_files | sort -z | tr '\0' '\n' > "$expected"
    sed -E 's/^[[:xdigit:]]{64}  //' "$manifest" | sort > "$actual"
    sed -E 's/^[[:xdigit:]]{64}  //' "$manifest" | sort | uniq -d > "$duplicates"

    if [[ -s "$duplicates" ]]; then
      echo "duplicate paths in $manifest:" >&2
      cat "$duplicates" >&2
      exit 1
    fi
    if ! diff -u "$expected" "$actual"; then
      echo "$manifest membership does not match tracked source files" >&2
      exit 1
    fi
    sha256sum -c "$manifest"
    ;;
  *)
    echo "usage: $0 <generate|verify>" >&2
    exit 2
    ;;
esac
