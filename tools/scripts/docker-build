#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"; cd "$ROOT"
DOCKER_BIN="${DOCKER_BIN:-docker}"
command -v "$DOCKER_BIN" >/dev/null || { echo "docker is required" >&2; exit 1; }
. "$ROOT/tools/scripts/lib/canonical-context.sh"
canonical_context_prepare "$ROOT"
staging="$(mktemp -d "$ROOT/.release-artifacts.XXXXXX")"
image=""; id=""
cleanup() {
  [[ -z "$id" ]] || "$DOCKER_BIN" rm -f "$id" >/dev/null 2>&1 || true
  [[ -z "$image" ]] || "$DOCKER_BIN" image rm "$image" >/dev/null 2>&1 || true
  rm -rf "$staging"
  canonical_context_cleanup
}
trap cleanup EXIT
image="$("$DOCKER_BIN" build --quiet --file "$CANONICAL_CONTEXT/Dockerfile.repro" --target artifact "$CANONICAL_CONTEXT")"
id="$("$DOCKER_BIN" create "$image" /bin/true)"
"$DOCKER_BIN" cp "$id:/release-artifacts/." "$staging/"
(cd "$staging" && sha256sum -c release-artifacts.sha256)

previous="$ROOT/.release-artifacts.previous"
rm -rf "$previous"
if [ -d "$ROOT/release-artifacts" ]; then
  mv "$ROOT/release-artifacts" "$previous"
fi
mv "$staging" "$ROOT/release-artifacts"
rm -rf "$previous"
echo
echo "Built canonical artifacts in release-artifacts/"
echo
echo "Source revision:"
echo "$CANONICAL_SOURCE_SHA"
echo
echo "Working tree:"
echo "clean (build context exported from the commit above)"
echo
echo "Mainnet module-hash comparison targets (*.wasm):"
echo
(cd release-artifacts && sha256sum event_horizon.wasm event_horizon_frontend.wasm)
echo
echo "Full artifact manifest:"
echo "release-artifacts/release-artifacts.sha256"
echo
echo "Verify manifest:"
echo "(cd release-artifacts && sha256sum -c release-artifacts.sha256)"
