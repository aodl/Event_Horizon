#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for interpreter in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$interpreter" >/dev/null 2>&1 \
    && "$interpreter" -c 'import tomllib' >/dev/null 2>&1; then
    exec "$interpreter" "$SCRIPT_DIR/block-buffer-osv-guard.py" "$@"
  fi
done

echo "block-buffer OSV guard requires Python 3.11 or newer with the standard-library tomllib module" >&2
exit 1
