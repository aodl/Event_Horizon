type HttpRequest = record { method : text; url : text; headers : vec record { text; text }; body : blob; certificate_version : opt nat16 };
type HttpResponse = record { status_code : nat16; headers : vec record { text; text }; body : blob; upgrade : opt bool; streaming_strategy : opt variant {} };
service : () -> {
  http_request : (HttpRequest) -> (HttpResponse) query;
}
