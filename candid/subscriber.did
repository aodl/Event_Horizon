type PokeTarget = variant {
  subaccount : nat64;
  neuron_nonce : nat64;
};
type PokeMatch = record {
  subject : principal;
  target : PokeTarget;
  first_block_index : nat64;
  max_amount : nat;
};
type PokeNotification = record {
  global_activity : bool;
  matches : vec PokeMatch;
};
service : {
  poke : (PokeNotification) -> ();
}
